---
import { profile, certifications, roles } from '../data/site.js';
const years = parseInt((profile.facts.find(([k]) => k === 'Experience') || ['', '4'])[1], 10) || 0;
const factCat = { Experience: 'cloud', Clouds: 'cloud', Certified: 'auto', Clients: 'integ', Studying: 'lwc', 'Based in': 'cloud' };
const cov = (roles.flatMap((r) => r.points).join(' ').match(/(\d+)%\s+(?:code\s+|test\s+)?coverage|above (\d+)% test coverage/i) || []);
const covN = parseInt(cov[1] || cov[2] || '90', 10);
---
<section id="top" class="act hero" data-trace="EXECUTION_STARTED" data-cat="cloud">
  <div class="wrap">
    <div class="viewer">
      <div class="viewer__rec">
        <span class="mono dim">Log</span>
        <h1 class="viewer__name">{profile.name}</h1>
        <span class="viewer__role">{profile.role}</span>
        <span class="status"><i class="status__dot" aria-hidden="true"></i>Open to Salesforce roles</span>
      </div>
      <p class="viewer__filter mono" role="status">
        <span><span class="dim">Filter</span> <span class="flt">*</span></span>
        <span><span class="dim">Lines</span> <b data-live-lines>…</b></span>
        <span><span class="dim">Transaction</span> running</span>
      </p>
    </div>

    <ol class="log log--hero" data-sc-in data-sc-stagger="70">
      <li class="ev" data-cat="cloud" style="--d:0">
        <span class="ln" aria-hidden="true"></span><span class="ts">depth=0</span>
        <span class="evn">EXECUTION_STARTED</span>
        <span class="msg">{profile.name} <span class="dim">/</span> {profile.role} <span class="dim">/</span> {profile.location}</span>
      </li>
      <li class="ev" data-cat="apex" style="--d:0">
        <span class="ln" aria-hidden="true"></span><span class="ts">profile.pitch</span>
        <span class="evn">USER_DEBUG</span>
        <span class="msg msg--lead">{profile.pitch}</span>
      </li>
      {profile.about.map((t, i) => (
        <li class="ev" data-cat="apex" style="--d:0">
          <span class="ln" aria-hidden="true"></span><span class="ts">{`profile.about[${i}]`}</span>
          <span class="evn">USER_DEBUG</span>
          <span class="msg">{t}</span>
        </li>
      ))}
      {profile.facts.map(([k, v]) => {
        const m = k === 'Experience' ? v.match(/^(\d+)\s+(.*)$/) : null;
        return (
          <li class="ev" data-cat={factCat[k] || 'cloud'} style="--d:0">
            <span class="ln" aria-hidden="true"></span><span class="ts">depth=0</span>
            <span class="evn">VARIABLE_ASSIGNMENT</span>
            <span class="msg kv"><span class="kv__k">{k}</span><span class="kv__op">=</span>
              {m ? <span><span class="kv__v" data-sc-count={`0 ${m[1]}`}>{m[1]}</span> {m[2]}</span> : <span class="kv__v">{v}</span>}
            </span>
          </li>
        );
      })}
      <li class="ev" data-cat="auto" style="--d:0">
        <span class="ln" aria-hidden="true"></span><span class="ts">depth=0</span>
        <span class="evn">VARIABLE_ASSIGNMENT</span>
        <span class="msg kv"><span class="kv__k">certifications</span><span class="kv__op">=</span><span class="kv__v" data-sc-count={`0 ${certifications.length}`}>{certifications.length}</span></span>
      </li>
      <li class="ev" data-cat="apex" style="--d:0">
        <span class="ln" aria-hidden="true"></span><span class="ts">depth=0</span>
        <span class="evn">VARIABLE_ASSIGNMENT</span>
        <span class="msg kv"><span class="kv__k">test_coverage</span><span class="kv__op">&gt;</span><span class="kv__v"><span data-sc-count={`0 ${covN}`}>{covN}</span>%</span></span>
      </li>
      <li class="ev ev--live" data-cat="cloud" style="--d:0">
        <span class="ln" aria-hidden="true"></span><span class="ts">depth=1</span>
        <span class="evn">CODE_UNIT_STARTED</span>
        <span class="msg">experience<span class="caret" aria-hidden="true"></span></span>
      </li>
    </ol>
  </div>
</section>
<script>
  const n = document.querySelectorAll('.ev').length;
  document.querySelectorAll('[data-live-lines]').forEach((e) => (e.textContent = String(n)));
</script>
