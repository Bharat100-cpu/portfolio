---
import { categories } from '../data/site.js';

// Fallback segments for the no-JS list. trace.js overwrites label and category
// from each section's own data-trace / data-cat, and hides entries with no section.
const segs = [
  { id: 'top', label: 'EXECUTION_STARTED', cat: 'apex' },
  { id: 'experience', label: 'METHOD_ENTRY', cat: 'cloud' },
  { id: 'work', label: 'CODE_UNIT_STARTED', cat: 'apex' },
  { id: 'tools', label: 'SYSTEM_MODE_ENTER', cat: 'lwc' },
  { id: 'skills', label: 'VARIABLE_SCOPE', cat: 'auto' },
  { id: 'credentials', label: 'USER_INFO', cat: 'integ' },
  { id: 'exec', label: 'EXEC_ANONYMOUS', cat: 'apex' },
];
const cats = Object.entries(categories);
---
<nav class="trace" aria-label="Execution trace" data-trace-rail>
  <section class="trace__ledger" id="trace-ledger" aria-labelledby="trace-ledger-h" data-ledger>
    <header class="ledger__head">
      <div>
        <h2 class="ledger__title" id="trace-ledger-h">Receipt</h2>
        <p class="ledger__sub">Cumulative, computed from this page</p>
      </div>
      <button type="button" class="ledger__close" data-ledger-close>Collapse</button>
    </header>
    <dl class="ledger__rows">
      <div class="ledger__row"><dt>Sections passed</dt><dd><b data-l="sections">0</b><span class="ledger__of" data-l="sections-of"></span></dd></div>
      <div class="ledger__row"><dt>Log lines read</dt><dd><b data-l="lines">0</b><span class="ledger__of" data-l="lines-of"></span></dd></div>
      {cats.map(([key, c]) => (
        <div class="ledger__row ledger__row--cat" data-cat={key}>
          <dt><i class="ledger__sw" aria-hidden="true"></i>{c.label}</dt>
          <dd><b data-l-cat={key}>0</b></dd>
          <span class="ledger__bar" aria-hidden="true"><i data-l-bar={key}></i></span>
        </div>
      ))}
      <div class="ledger__row"><dt>Details opened</dt><dd><b data-l="details">0</b><span class="ledger__of" data-l="details-of"></span></dd></div>
      <div class="ledger__row"><dt>Commands run</dt><dd><b data-l="cmds">0</b></dd></div>
    </dl>
    <footer class="ledger__foot">
      <span>Replay clock is scaled from scroll position, for flavour.</span>
      <a href="#top" data-ledger-top>Back to top</a>
    </footer>
  </section>

  <div class="trace__bar">
    <span class="trace__tag" aria-hidden="true">TRACE</span>
    <ol class="trace__segs">
      {segs.map((s) => (
        <li class="trace__li" data-seg-li={s.id}>
          <a class="trace__seg" href={`#${s.id}`} data-seg={s.id} data-cat={s.cat}>
            <span class="seg__top">
              <i class="seg__flag" aria-hidden="true"></i>
              <span class="seg__label">{s.label}</span>
              <span class="seg__n" aria-hidden="true"></span>
            </span>
            <span class="seg__track" aria-hidden="true"><i class="seg__fill"></i></span>
          </a>
        </li>
      ))}
    </ol>
    <span class="trace__head" aria-hidden="true"></span>
    <span class="trace__clock" title="Replay clock, scaled from scroll position">
      <span class="trace__k">REPLAY</span> <span data-clock>00:00.0</span>
    </span>
    <button type="button" class="trace__toggle" aria-expanded="false" aria-controls="trace-ledger" data-ledger-toggle>
      <span class="trace__k">LINES <span data-lines>0</span></span>
      <span class="trace__rcpt">Receipt <span aria-hidden="true" class="trace__chev">&#9652;</span></span>
    </button>
  </div>
</nav>
