---
import '../styles/rest.css';
import { certifications, superbadges, education, links } from '../data/site.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const src = (f) => `${base}img/${f}`;
---
<section id="credentials" class="sec" aria-labelledby="credentials-h">
  <header class="sec-head rv">
    <span class="sec-num" aria-hidden="true">04</span>
    <h2 id="credentials-h" class="sec-ttl">Credentials</h2>
  </header>

  <h3 class="sub rv">Certifications</h3>
  <ul class="badges">
    {certifications.map((c) => (
      <li class="rv">
        <a class="badge glass" href={links.trailhead} target="_blank" rel="noopener noreferrer" aria-label={`${c.name} on Trailhead (opens in a new tab)`}>
          <img src={src(c.img)} alt="" width="160" height="160" loading="lazy" decoding="async" />
          <span class="b-name">{c.name}</span>
          <span class="b-sub">Certification</span>
        </a>
      </li>
    ))}
  </ul>

  <h3 class="sub rv">Superbadges</h3>
  <ul class="badges">
    {superbadges.map((c) => (
      <li class="rv">
        <a class="badge glass" href={links.trailhead} target="_blank" rel="noopener noreferrer" aria-label={`${c.name}, ${c.sub}, on Trailhead (opens in a new tab)`}>
          <img src={src(c.img)} alt="" width="160" height="160" loading="lazy" decoding="async" />
          <span class="b-name">{c.name}</span>
          <span class="b-sub">{c.sub}</span>
        </a>
      </li>
    ))}
  </ul>

  <h3 class="sub rv">Education</h3>
  <ul class="edu">
    {education.map((e) => (
      <li class="glass rv">
        <strong>{e.degree}</strong>
        <span>{e.school}</span>
        <em>{e.when}</em>
      </li>
    ))}
  </ul>
</section>
