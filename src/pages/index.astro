---
import '../styles/global.css';
import { profile, links, stats, tokens, skillGroups, projects, roles, tiles } from '../data/site.js';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const site = 'https://bharat100-cpu.github.io/portfolio/';
const title = 'Bharat Kumar · Salesforce Developer';
const description =
  'Salesforce Developer with 4 years across Experience, Sales and Service Cloud. Apex, LWC, integrations and automation for Pinterest, Assurant, CleverTap and more.';
const resume = `${base}Resume.pdf`;
const tileHref = (h) => (h === 'RESUME' ? resume : h);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${links.email}`,
  url: site,
  address: { '@type': 'PostalAddress', addressLocality: 'Mathura', addressRegion: 'Uttar Pradesh', addressCountry: 'IN' },
  sameAs: [links.linkedin, links.trailhead, links.github],
  knowsAbout: tokens.map((t) => t.name),
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Chandigarh University' },
    { '@type': 'CollegeOrUniversity', name: 'Bon Maharaj Institute of Management & Technology' },
  ],
};
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-NZNLNPV2');</script>
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#04060d" />
    <link rel="canonical" href={site} />
    <link rel="icon" href={`${base}favicon.png`} type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={`${site}og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bharat Kumar, Salesforce Developer" />
    <meta property="og:site_name" content="Bharat Kumar" />
    <meta property="og:locale" content="en_IN" />
    <meta name="author" content={profile.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}og.png`} />
    <meta name="color-scheme" content="dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NZNLNPV2" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <a class="skip" href="#main">Skip to content</a>
    <div class="nebula" aria-hidden="true"></div>
    <nav aria-label="Primary">
      <span class="logo" aria-hidden="true">BK.</span>
      <a href="#hero" data-s="0" class="hide-m">Home</a>
      <a href="#skills" data-s="1" class="hide-m">Skills</a>
      <a href="#work" data-s="2" class="hide-m">Work</a>
      <a href="#experience" data-s="3" class="hide-m">Experience</a>
      <a href="#credentials" data-s="4" class="hide-m">Credentials</a>
      <a href={resume} class="btn" download aria-label="Download résumé (PDF)">Résumé</a>
      <a href="#contact" data-s="5" class="cta">Let's talk</a>
    </nav>

    <main class="static" id="main">
      <section id="hero" class="blk" aria-labelledby="hero-h"><div class="wrap">
        <p class="kick rv">Portfolio</p>
        <h1 id="hero-h" class="rv">Hi, I'm<br /><em>{profile.name}</em></h1>
        <p class="role rv">&gt; {profile.role} · Experience Cloud</p>
        <p class="lede rv">{profile.longSummary}</p>
        <div class="btns rv"><a class="b p" href="#work">View my work</a><a class="b" href={resume} download>Download résumé</a></div>
        <div class="statrow rv">{stats.map(([n, l]) => <div><b>{n}</b><span>{l}</span></div>)}</div>
      </div></section>

      <section id="skills" class="blk" aria-labelledby="skills-h"><div class="wrap">
        <p class="kick rv">Skills</p>
        <h2 id="skills-h" class="rv">Twelve tools, <em>one platform</em></h2>
        <div class="chips rv">{tokens.map((t) => <span>{t.name}</span>)}</div>
        <div class="groups" style="margin-top:22px">{skillGroups.map(([h, p]) => <div class="group rv"><h3>{h}</h3><p>{p}</p></div>)}</div>
      </div></section>

      <section id="work" class="blk" aria-labelledby="work-h"><div class="wrap">
        <p class="kick rv">Selected work</p>
        <h2 id="work-h" class="rv">Work that <em>shipped</em></h2>
        <div class="cards">{projects.map((p) => (
          <article class="cardx rv"><div class="k">{p.kicker}</div><h3>{p.title}</h3>
            <ul>{p.points.map((x) => <li>{x}</li>)}</ul>
            <div class="env">{p.env}</div></article>
        ))}</div>
      </div></section>

      <section id="experience" class="blk" aria-labelledby="experience-h"><div class="wrap">
        <p class="kick rv">Experience</p>
        <h2 id="experience-h" class="rv">Where I've <em>built</em></h2>
        {roles.map((r) => (
          <div class="role-blk rv"><h3>{r.title} · {r.company}</h3><div class="when">{r.when}</div>
            <ul>{r.points.map((x) => <li>{x}</li>)}</ul></div>
        ))}
      </div></section>

      <section id="credentials" class="blk" aria-labelledby="credentials-h"><div class="wrap">
        <p class="kick rv">Credentials</p>
        <h2 id="credentials-h" class="rv">Certified &amp; <em>proven</em></h2>
        <div class="tiles">{tiles.map((t) => {
          const inner = (<>
            {t.img ? <img src={`${base}img/${t.img}`} alt="" loading="lazy" /> : <div class="big">{t.big}</div>}
            <div>{t.name}<small>{t.sub}</small></div></>);
          return t.href
            ? <a class="tile rv" href={tileHref(t.href)} target={t.href === 'RESUME' ? undefined : '_blank'} rel="noopener">{inner}</a>
            : <div class="tile rv">{inner}</div>;
        })}</div>
      </div></section>

      <section id="contact" class="blk" aria-labelledby="contact-h"><div class="wrap">
        <p class="kick rv">Contact</p>
        <h2 id="contact-h" class="rv">Let's build <em>something great</em></h2>
        <p class="lede rv">Open to new Salesforce roles. Based in {profile.location}.</p>
        <div class="linkrow rv">
          <a href={`mailto:${links.email}`}>Email<span>{links.email}</span></a>
          <a href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span>in/kumar-bharat</span></a>
          <a href={links.trailhead} target="_blank" rel="noopener noreferrer">Trailhead<span>trailblazer/bharatkumar2002</span></a>
          <a href={links.github} target="_blank" rel="noopener noreferrer">GitHub<span>Bharat100-cpu</span></a>
          <a href={resume} download>Résumé<span>download PDF</span></a>
        </div>
        <footer class="foot">© 2026 {profile.name} · {profile.location}</footer>
      </div></section>
    </main>

    <script>
      import '../scripts/morph.js';
      // Reveal-on-scroll for the stacked layout (phones, reduced motion, no stage).
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
      document.querySelectorAll('.rv').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
