---
import '../styles/live.css';
import { projects, solutions, skills, skillCat, links, categories } from '../data/site.js';

const choices = [
  ['apex', 'Apex', 'Triggers, batch and queueable jobs'],
  ['lwc', 'LWC', 'Lightning Web Components and UI'],
  ['integ', 'Integration', 'REST / SOAP and Connected Apps'],
  ['auto', 'Automation', 'Flows and scheduled processing'],
];
const all = [...projects, ...solutions];
const results = Object.fromEntries(
  choices.map(([cat]) => [
    cat,
    {
      work: all
        .filter((p) => p.stack.some((s) => skillCat[s] === cat))
        .map((p) => ({ title: p.title, headline: p.headline, hits: p.stack.filter((s) => skillCat[s] === cat) })),
      skills: skills.filter((s) => skillCat[s] === cat),
    },
  ]),
);
---
<section class="panel flow" id="flow" aria-labelledby="flow-t" data-flow data-email={links.email}>
  <header class="lv-h">
    <span class="lv-ic" aria-hidden="true">⇄</span>
    <div>
      <h2 id="flow-t">Hire_Bharat</h2>
      <p class="lv-sub">Screen Flow · Active · v1</p>
    </div>
    <span class="flow-state" data-flow-state role="status">Waiting for input</span>
  </header>

  <ol class="canvas">
    <li class="node start" data-state="done">
      <span class="dot" aria-hidden="true">▶</span>
      <span class="nlabel"><b>Start</b> <small>Screen Flow</small></span>
    </li>
    <li class="wire" aria-hidden="true"></li>

    <li class="node screen" data-state="active" data-node="screen">
      <div class="nhead"><span class="ntype">Screen</span><span class="nname">What_Do_You_Need</span></div>
      <fieldset class="nbody">
        <legend>What do you need built?</legend>
        <div class="opts">
          {choices.map(([cat, label, hint]) => (
            <label class="opt" data-cat={cat}>
              <input type="radio" name="flow-need" value={cat} />
              <span class="optface"><b>{label}</b><small>{hint}</small></span>
            </label>
          ))}
        </div>
        <button type="button" class="lv-btn" data-flow-next disabled>Next ›</button>
      </fieldset>
    </li>
    <li class="wire" aria-hidden="true"></li>

    <li class="node decision" data-state="todo" data-node="decision">
      <div class="nhead"><span class="ntype">Decision</span><span class="nname">Has_Matching_Work</span></div>
      <div class="nbody" hidden>
        <p class="dec" data-flow-dec>Matches?</p>
      </div>
    </li>
    <li class="wire" aria-hidden="true"></li>

    <li class="node action" data-state="todo" data-node="action">
      <div class="nhead"><span class="ntype">Action</span><span class="nname">Get_Matching_Work</span></div>
      <div class="nbody" hidden>
        {choices.map(([cat, label]) => (
          <div class="res" data-res={cat} hidden>
            <ul class="reslist">
              {results[cat].work.map((w) => (
                <li>
                  <a href="#work"><b>{w.title}</b> <span>{w.headline}</span></a>
                  <em>{w.hits.join(' · ')}</em>
                </li>
              ))}
            </ul>
            <p class="chips">
              {results[cat].skills.map((s) => <span class="chip" data-cat={cat}>{s}</span>)}
            </p>
          </div>
        ))}
      </div>
    </li>
    <li class="wire" aria-hidden="true"></li>

    <li class="node end" data-state="todo" data-node="end">
      <div class="nhead"><span class="ntype">End</span><span class="nname">Interview requested</span></div>
      <div class="nbody" hidden>
        <p>Flow finished. Next element: you.</p>
        <a class="lv-btn pri" href={`mailto:${links.email}`} data-flow-mail>Email Bharat</a>
      </div>
    </li>
  </ol>
  <footer class="lv-f">
    <button type="button" class="lv-link" data-flow-reset hidden>↺ Run again</button>
    <span class="lv-hint">Tab / arrow keys to choose, Enter to continue</span>
  </footer>
  <script type="application/json" data-flow-labels set:html={JSON.stringify(Object.fromEntries(choices.map(([c, l]) => [c, l])))} />
</section>
