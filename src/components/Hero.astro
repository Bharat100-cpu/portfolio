---
import '../styles/hero.css';
import { profile, links, skills, categories, skillCat, certifications } from '../data/site.js';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const resumeHref = `${base}Resume.pdf`;
const [first, ...rest] = profile.name.split(' ');
const graph = {
  center: first,
  nodes: skills.map((s) => ({ label: s, cat: skillCat[s] })),
  cats: Object.fromEntries(Object.entries(categories).map(([k, v]) => [k, { label: v.label, hue: v.hue }])),
};
const stats = [
  { n: 4, suffix: '', label: 'Years on Salesforce' },
  { n: 3, suffix: '', label: 'Flagship clients', sub: 'Pinterest · Assurant · CleverTap' },
  { n: certifications.length, suffix: '', label: 'Active certifications' },
  { n: 90, suffix: '%+', label: 'Apex test coverage' },
];
---

<section class="hero" id="top" aria-labelledby="hero-name" data-hero>
  <div class="hero-aurora" aria-hidden="true">
    <span class="blob b1"></span>
    <span class="blob b2"></span>
    <span class="blob b3"></span>
    <span class="blob b4"></span>
    <span class="hero-grid"></span>
    <span class="hero-vignette"></span>
  </div>

  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-pill"><span class="dot" aria-hidden="true"></span>Open to Salesforce roles</p>

      <h1 id="hero-name" class="hero-name">
        <span class="grad-text">{first}</span> <span class="grad-text">{rest.join(' ')}</span>
      </h1>

      <p class="hero-role">
        <span class="role-label">{profile.role}</span>
        <span class="role-sep" aria-hidden="true">/</span>
        <span class="hero-type" aria-hidden="true"><span data-type></span><i class="caret"></i></span>
      </p>

      <p class="hero-pitch">{profile.pitch}</p>

      <div class="hero-cta">
        <a class="btn btn-primary" href={resumeHref} download>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3v12m0 0l-4.5-4.5M12 15l4.5-4.5M5 20h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Download résumé
        </a>
        <a class="btn btn-ghost" href={`mailto:${links.email}`}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M3 6h18v12H3zM3 7l9 6 9-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Email me
        </a>
      </div>
    </div>

    <div class="hero-graph">
      <div class="graph-stage" data-graph-stage>
        <canvas data-graph aria-hidden="true"></canvas>
      </div>
      <ul class="graph-legend" aria-label="Colour code for skill categories">
        {Object.entries(categories).map(([key, c]) => (
          <li data-cat={key} data-legend={key}><i aria-hidden="true"></i>{c.label}</li>
        ))}
      </ul>
      <ul class="sr-only" aria-label="Skills">
        {skills.map((s) => <li>{s} ({categories[skillCat[s]].label})</li>)}
      </ul>
      <script type="application/json" data-graph-data set:html={JSON.stringify(graph)} />
    </div>
  </div>

  <ul class="hero-stats">
    {stats.map((s) => (
      <li>
        <strong class="stat-num"><span data-count={s.n} data-suffix={s.suffix}>{s.n}{s.suffix}</span></strong>
        <span class="stat-label">{s.label}</span>
        {s.sub && <span class="stat-sub">{s.sub}</span>}
      </li>
    ))}
  </ul>
</section>

<script>
  import '../scripts/hero.js';
</script>
