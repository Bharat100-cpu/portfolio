---
import '../styles/tokens.css';
import '../styles/console.css';
import '../styles/trace.css';
import Chrome from '../components/Chrome.astro';
import LogHero from '../components/LogHero.astro';
import LogExperience from '../components/LogExperience.astro';
import LogWork from '../components/LogWork.astro';
import LogSkills from '../components/LogSkills.astro';
import LogCreds from '../components/LogCreds.astro';
import Cmdline from '../components/Cmdline.astro';
import TraceRail from '../components/TraceRail.astro';
import { profile, links, skills, certifications } from '../data/site.js';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const site = 'https://bharat100-cpu.github.io/portfolio/';
const title = 'Bharat Kumar · Salesforce Developer';
const description =
  'Salesforce Developer with 4 years across Experience, Sales and Service Cloud. Apex, LWC, integrations and automation for Pinterest, Assurant, CleverTap and more.';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${links.email}`,
  url: site,
  address: { '@type': 'PostalAddress', addressLocality: 'Mathura', addressRegion: 'Uttar Pradesh', addressCountry: 'IN' },
  sameAs: [links.linkedin, links.trailhead, links.github],
  knowsAbout: skills,
  hasCredential: certifications.map((c) => ({ '@type': 'EducationalOccupationalCredential', name: `Salesforce Certified ${c.name}` })),
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Chandigarh University' },
    { '@type': 'CollegeOrUniversity', name: 'Bon Maharaj Institute of Management & Technology' },
  ],
};
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>if(location.hostname.endsWith('github.io'))addEventListener('load',function(){setTimeout(function(){(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-NZNLNPV2')},1500)});</script>
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0b0d" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={site} />
    <link rel="stylesheet" href={`${base}sc/scrollcraft.css`} />
    <link rel="icon" href={`${base}favicon.png`} type="image/png" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={`${site}og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bharat Kumar, Salesforce Developer" />
    <meta property="og:site_name" content="Bharat Kumar" />
    <meta property="og:locale" content="en_IN" />
    <meta name="author" content={profile.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}og.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NZNLNPV2" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <a class="skip" href="#main">Skip to content</a>
    <Chrome />
    <main id="main">
      <LogHero />
      <LogExperience />
      <LogWork />
      <LogSkills />
      <LogCreds />
      <Cmdline />
    </main>
    <TraceRail />
    <div class="toast" role="status" aria-live="polite"></div>
    <script is:inline src={`${base}sc/scrollcraft.js`}></script>
    <script is:inline>ScrollCraft.mount(document.body);</script>
    <script>
      import '../scripts/trace.js';
    </script>
  </body>
</html>
