---
import { certifications, superbadges, education, links } from '../data/site.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const dims = {
  'Platform-Developer-I.png': [1892, 1855], 'ai-associate.png': [1892, 1855],
  'Associate.png': [355, 203], 'ai-specialist.png': [355, 203],
  'apex-specialist.png': [200, 200], 'apex-web-services-superbadge-unit.webp': [200, 221],
  'lightning-web-components-specialist.webp': [200, 200], 'named-credentials-superbadge-unit.webp': [200, 200],
};
const items = [
  ...certifications.map((c) => ({ ...c, full: `Salesforce Certified ${c.name}`, kind: 'Certification', cat: 'auto' })),
  ...superbadges.map((c) => ({ ...c, full: c.name, kind: c.sub, cat: 'apex' })),
];
---
<section id="credentials" class="act" data-trace="CODE_UNIT_FINISHED" data-cat="cloud">
  <div class="wrap">
    <div class="frame-head"><span class="evn">CODE_UNIT_FINISHED</span><h2 class="frame-head__t">Credentials</h2><span class="mono dim">stack depth 1</span></div>
    <ol class="log" data-sc-in data-sc-stagger="50">
      {items.map((c) => (
        <li class="ev ev--cred" data-cat={c.cat} style="--d:0">
          <span class="ln" aria-hidden="true"></span><span class="ts">{c.kind}</span>
          <span class="evn">CODE_UNIT_FINISHED</span>
          <span class="msg">
            <a class="cred" href={links.trailhead} target="_blank" rel="noopener noreferrer">
              <img src={`${base}img/${c.img}`} width={dims[c.img][0]} height={dims[c.img][1]} loading="lazy" decoding="async" alt="" />
              <span>{c.full}<span class="sr-only"> (opens Trailhead profile in a new tab)</span></span>
            </a>
          </span>
        </li>
      ))}
      {education.map((e) => (
        <li class="ev" data-cat="cloud" style="--d:0">
          <span class="ln" aria-hidden="true"></span><span class="ts">{e.when}</span>
          <span class="evn">CODE_UNIT_FINISHED</span>
          <span class="msg"><b>{e.degree}</b> <span class="dim">/</span> {e.school}</span>
        </li>
      ))}
    </ol>
  </div>
</section>
